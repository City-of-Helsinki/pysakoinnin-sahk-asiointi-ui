    "jsdom": "^26.1.0",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^1.1.5",
    "vitest-fetch-mock": "^0.4.5"
  }
