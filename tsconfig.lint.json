{
    "extends": "./tsconfig.json",
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/utils/renderWithProviders.tsx",
        "vite.config.mts",
        "vitest.config.mts",
        "eslint.config.mjs",
    ],
    "compilerOptions": {
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "types": [
            "vite/client",
            "vite-plugin-svgr/client",
            "vitest/globals"
        ],
    },
    "exclude": []
}